{
    "name": "spryker-community/search-toolkit",
    "type": "metapackage",
    "description": "Bundle package for the Spryker search toolkit: require this to pull in search-debug, search-ranking, search-ranking-optimizer, search-feedback, search-variant-facets, search-index-alias, and search-analyzer-config together at compatible versions.",
    "license": "MIT",
    "keywords": [
        "spryker",
        "elasticsearch",
        "opensearch",
        "search",
        "relevance",
        "ranking",
        "toolkit"
    ],
    "require": {
        "spryker-community/search-debug": "^1.4.0",
        "spryker-community/search-ranking": "^2.4.0",
        "spryker-community/search-ranking-optimizer": "^2.1.0",
        "spryker-community/search-feedback": "^1.5.0",
        "spryker-community/search-variant-facets": "^1.0.2",
        "spryker-community/search-index-alias": "^2.0.1",
        "spryker-community/search-analyzer-config": "^1.0.1"
    },
    "minimum-stability": "stable",
    "homepage": "https://github.com/andrebarthelmeshellmuth/spryker-search-toolkit",
    "authors": [
        {
            "name": "Andre Barthelmes",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/andrebarthelmeshellmuth/spryker-search-toolkit/issues",
        "source": "https://github.com/andrebarthelmeshellmuth/spryker-search-toolkit"
    }
}
